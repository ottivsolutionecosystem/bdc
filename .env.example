DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bdc_dev"
AUTH_SECRET="gere-um-segredo-com-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
# Em desenvolvimento, o pedido de redefinição de senha mostra o link na tela.
AUTH_DEV_RESET_LINKS=true
# Webhook n8n padrão para avisar o grupo de vendedores (a campanha pode sobrescrever).
SELLERS_GROUP_WEBHOOK_URL=
# Token padrão Wavoip (Click to Call). A agente pode ter o próprio em Usuários.
WAVOIP_DEVICE_TOKEN=
