// Prisma schema — CRM base, campanhas de ligação (campaign_*) e feirão (fair_*).
// A campanha continua genérica. O feirão é o controle físico, da entrada à entrega.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// Base mínima do CRM (reutilizada pelo módulo de campanhas)
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  SUPERVISOR
  AGENT
  SELLER
  RECEPTIONIST
  APPRAISER
  FINANCE
  DELIVERY
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role                   UserRole
  active                 Boolean   @default(true)
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  /** Token do dispositivo Wavoip (ligação na Operação). */
  wavoipDeviceToken      String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  createdCampaigns           Campaign[]                         @relation("CampaignCreatedBy")
  campaignAgentOf            CampaignAgent[]
  assignedContacts           CampaignContact[]                  @relation("ContactAssignedAgent")
  lockedContacts             CampaignContact[]                  @relation("ContactLockedBy")
  supervisorQueuedContacts   CampaignContact[]                  @relation("ContactSupervisorQueuedBy")
  attempts                   CampaignContactAttempt[]
  assignmentHistoryFrom      CampaignContactAssignmentHistory[] @relation("AssignmentFromAgent")
  assignmentHistoryTo        CampaignContactAssignmentHistory[] @relation("AssignmentToAgent")
  assignmentHistoryChangedBy CampaignContactAssignmentHistory[] @relation("AssignmentChangedBy")
  transfersAsAgent           CampaignTransfer[]                 @relation("TransferAgent")
  transfersAsSeller          CampaignTransfer[]                 @relation("TransferSeller")
  imports                    CampaignImport[]
  sellerOpportunities        Opportunity[]                      @relation("OpportunitySeller")
  sellerAppointments         Appointment[]                      @relation("AppointmentSeller")
  auditLogs                  AuditLog[]
  createdFairEvents          FairEvent[]                        @relation("FairEventCreatedBy")
  receptionVisits            FairVisit[]                        @relation("VisitReceptionist")
  sellerFairVisits           FairVisit[]                        @relation("VisitSeller")
  financeVisits              FairVisit[]                        @relation("VisitFinance")
  deliveryVisits             FairVisit[]                        @relation("VisitDelivery")
  appraisals                 FairAppraisal[]                    @relation("AppraisalAppraiser")
  assignedDeliveries         FairDelivery[]                     @relation("DeliveryAssignee")

  @@map("users")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  document  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaignContacts CampaignContact[]
  opportunities    Opportunity[]
  appointments     Appointment[]
  fairVisits       FairVisit[]

  @@index([phone])
  @@map("customers")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

model Opportunity {
  id               String            @id @default(cuid())
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id])
  sellerId         String?
  seller           User?             @relation("OpportunitySeller", fields: [sellerId], references: [id])
  originCampaignId String?
  originCampaign   Campaign?         @relation(fields: [originCampaignId], references: [id])
  status           OpportunityStatus @default(OPEN)
  source           String
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  transfers  CampaignTransfer[]
  fairVisits FairVisit[]

  @@index([customerId])
  @@index([sellerId])
  @@index([originCampaignId])
  @@map("opportunities")
}

enum AppointmentStatus {
  SCHEDULED
  DONE
  CANCELED
}

model Appointment {
  id                      String            @id @default(cuid())
  customerId              String
  customer                Customer          @relation(fields: [customerId], references: [id])
  sellerId                String?
  seller                  User?             @relation("AppointmentSeller", fields: [sellerId], references: [id])
  scheduledAt             DateTime
  notes                   String?
  status                  AppointmentStatus @default(SCHEDULED)
  originCampaignContactId String?           @unique
  originCampaignContact   CampaignContact?  @relation(fields: [originCampaignContactId], references: [id])
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([customerId])
  @@index([sellerId])
  @@index([scheduledAt])
  @@map("appointments")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  entityType String
  entityId   String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// Núcleo de Campanhas de Ligação (campaign_*)
// ─────────────────────────────────────────────────────────────────────────

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELED
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?
  type        String
  status      CampaignStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  createdById String
  createdBy   User           @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  /** URL do webhook n8n que avisa o grupo de vendedores. */
  sellersNotifyWebhookUrl String?
  /** Token Wavoip da campanha (botão Ligar da Operação). A agente pode ter o próprio. */
  wavoipDeviceToken       String?

  agents            CampaignAgent[]
  contacts          CampaignContact[]
  dispositions      CampaignDisposition[]
  imports           CampaignImport[]
  importSessions    CampaignImportSession[]
  distributionState CampaignDistributionState?
  opportunities     Opportunity[]
  fairEvents        FairEvent[]

  @@index([status])
  @@map("campaigns")
}

model CampaignAgent {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  active        Boolean  @default(true)
  assignedCount Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([campaignId, userId])
  @@index([campaignId, active])
  @@map("campaign_agents")
}

enum DispositionCategory {
  POSITIVE
  CONVERSION
  FOLLOW_UP
  NO_INTEREST
  NOT_REACHED
}

enum ContactTemperature {
  HOT
  WARM
  FOLLOW_UP
  COLD
  NOT_REACHED
}

model CampaignDisposition {
  id                  String              @id @default(cuid())
  campaignId          String?
  campaign            Campaign?           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  code                String
  label               String
  category            DispositionCategory
  requiresNextContact Boolean             @default(false)
  defaultTemperature  ContactTemperature
  order               Int                 @default(0)
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  attempts         CampaignContactAttempt[]
  finalForContacts CampaignContact[]        @relation("ContactFinalDisposition")
  transfers        CampaignTransfer[]

  @@unique([campaignId, code])
  @@index([category])
  @@map("campaign_dispositions")
}

enum ContactStatus {
  UNTREATED
  ATTEMPTING
  FOLLOW_UP
  TREATED
  CONVERTED
  NOT_REACHED
}

enum PurchaseTimeline {
  NOW
  WITHIN_30D
  D60_90
  NO_FORECAST
}

enum EventInterest {
  YES
  MAYBE
  NO
}

model CampaignContact {
  id         String    @id @default(cuid())
  campaignId String
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  name             String
  phone            String
  phoneNormalized  String
  lastVehicle      String?
  lastPurchaseDate DateTime?

  assignedAgentId String?
  assignedAgent   User?   @relation("ContactAssignedAgent", fields: [assignedAgentId], references: [id])

  status                    ContactStatus      @default(UNTREATED)
  temperature               ContactTemperature @default(COLD)
  temperatureManualOverride Boolean            @default(false)

  attemptsCount Int       @default(0)
  lastAttemptAt DateTime?
  nextContactAt DateTime?

  finalDispositionId String?
  finalDisposition   CampaignDisposition? @relation("ContactFinalDisposition", fields: [finalDispositionId], references: [id])
  notes              String?

  interestedInEvent    EventInterest?
  stillOwnsLastVehicle Boolean?
  interestedInTrade    Boolean?
  currentVehicle       String?
  purchaseTimeline     PurchaseTimeline?

  appointment             Appointment?
  transferredToSales      Boolean      @default(false)
  sellersGroupNotifiedAt  DateTime?

  lockedByUserId String?
  lockedByUser   User?     @relation("ContactLockedBy", fields: [lockedByUserId], references: [id])
  lockedAt       DateTime?
  lockExpiresAt  DateTime?

  supervisorQueuedAt   DateTime?
  supervisorQueuedById String?
  supervisorQueuedBy   User?     @relation("ContactSupervisorQueuedBy", fields: [supervisorQueuedById], references: [id])
  supervisorQueueKind  String?
  supervisorQueueNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts          CampaignContactAttempt[]
  assignmentHistory CampaignContactAssignmentHistory[]
  transfers         CampaignTransfer[]

  @@index([campaignId, assignedAgentId, status])
  @@index([campaignId, nextContactAt])
  @@index([campaignId, status])
  @@index([phoneNormalized])
  @@index([finalDispositionId])
  @@index([lockExpiresAt])
  @@map("campaign_contacts")
}

model CampaignContactAttempt {
  id                 String              @id @default(cuid())
  campaignId         String
  contactId          String
  contact            CampaignContact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agentId            String
  agent              User                @relation(fields: [agentId], references: [id])
  attemptNumber      Int
  dispositionId      String
  disposition        CampaignDisposition @relation(fields: [dispositionId], references: [id])
  statusAfterAttempt ContactStatus
  notes              String?
  contacted          Boolean
  nextContactAt      DateTime?
  createdAt          DateTime            @default(now())

  @@index([contactId, attemptNumber])
  @@index([campaignId, agentId])
  @@map("campaign_contact_attempts")
}

enum AssignmentChangeReason {
  IMPORT
  REDISTRIBUTE
  MANUAL
  AGENT_REMOVED
}

model CampaignContactAssignmentHistory {
  id          String                 @id @default(cuid())
  contactId   String
  contact     CampaignContact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  fromAgentId String?
  fromAgent   User?                  @relation("AssignmentFromAgent", fields: [fromAgentId], references: [id])
  toAgentId   String?
  toAgent     User?                  @relation("AssignmentToAgent", fields: [toAgentId], references: [id])
  reason      AssignmentChangeReason
  changedById String
  changedBy   User                   @relation("AssignmentChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime               @default(now())

  @@index([contactId])
  @@map("campaign_contact_assignment_history")
}

model CampaignImport {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  fileName      String
  totalRows     Int
  imported      Int
  ignored       Int
  invalid       Int
  duplicated    Int
  columnMapping Json
  createdAt     DateTime @default(now())

  @@index([campaignId])
  @@map("campaign_imports")
}

model CampaignImportSession {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  fileName   String
  headers    Json
  rows       Json
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([campaignId])
  @@index([expiresAt])
  @@map("campaign_import_sessions")
}

model CampaignTransfer {
  id            String               @id @default(cuid())
  contactId     String
  contact       CampaignContact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        User                 @relation("TransferSeller", fields: [sellerId], references: [id])
  agentId       String
  agent         User                 @relation("TransferAgent", fields: [agentId], references: [id])
  dispositionId String?
  disposition   CampaignDisposition? @relation(fields: [dispositionId], references: [id])
  notes         String?
  opportunityId String?
  createdAt     DateTime             @default(now())
  opportunity   Opportunity?         @relation(fields: [opportunityId], references: [id])

  @@index([contactId])
  @@index([sellerId])
  @@map("campaign_transfers")
}

// Ponteiro persistente do round robin de distribuição — garante que novas
// importações continuem o rodízio em vez de reiniciar do primeiro agente.
model CampaignDistributionState {
  campaignId  String   @id
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lastAgentId String?
  updatedAt   DateTime @updatedAt

  @@map("campaign_distribution_state")
}

// ─────────────────────────────────────────────────────────────────────────
// Feirão — controle físico da entrada até a entrega
// ─────────────────────────────────────────────────────────────────────────

enum FairEventStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum FairVisitStage {
  WITH_SELLER
  IN_APPRAISAL
  WITH_FINANCE
  AWAITING_DELIVERY
  DELIVERED
  LOST
}

enum FairEntryChannel {
  WALK_IN
  CAMPAIGN
  RETURN
}

enum FairAwarenessSource {
  INSTAGRAM
  RADIO
  REFERRAL
  OUTDOOR
  WHATSAPP
  CALL_CAMPAIGN
  PASSING_BY
  OTHER
}

enum FairArrivalMode {
  OWN_CAR
  RIDESHARE
  BUS
  WALK
  RIDE
  OTHER
}

enum FairAppraisalStatus {
  REQUESTED
  IN_PROGRESS
  DONE
}

enum FairDeliveryStatus {
  QUEUED
  IN_PROGRESS
  DONE
}

enum FairPhotoSlot {
  FRONT
  RIGHT
  LEFT
  REAR
  DASHBOARD
  DAMAGE
}

enum TireCondition {
  GOOD
  HALF
  REPLACE
}

enum FairAppraisalCostKind {
  DAMAGE
  MECHANICAL
}

enum FairTaskStatus {
  PENDING
  IN_PROGRESS
  WAITING
  BLOCKED
  DONE
  CANCELED
}

enum FairTaskPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model FairEvent {
  id          String          @id @default(cuid())
  name        String
  location    String?
  startsAt    DateTime?
  endsAt      DateTime?
  status      FairEventStatus @default(DRAFT)
  campaignId  String?
  campaign    Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User            @relation("FairEventCreatedBy", fields: [createdById], references: [id])
  /** Projeções opcionais. Ficam vazias até o admin preencher. */
  vehicleGoal      Int?
  budgetCents      Int?
  captureGoalCents Int?
  capturedCents    Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  vehicles FairVehicle[]
  visits   FairVisit[]
  tasks    FairTask[]
  expenses FairExpense[]

  @@index([status])
  @@map("fair_events")
}

model FairVehicle {
  id        String    @id @default(cuid())
  eventId   String
  event     FairEvent @relation(fields: [eventId], references: [id])
  brand        String
  model        String
  version      String?
  year         Int?
  plate        String?
  color        String?
  priceCents   Int?
  condition    String?
  transmission String?
  bodyType     String?
  mileageKm    Int?
  onPromotion  Boolean   @default(false)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  interests  FairVisitInterest[]
  deliveries FairDelivery[]

  @@index([eventId, active])
  @@map("fair_vehicles")
}

model FairVisit {
  id              String    @id @default(cuid())
  eventId         String
  event           FairEvent @relation(fields: [eventId], references: [id])
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id])
  receptionistId  String
  receptionist    User      @relation("VisitReceptionist", fields: [receptionistId], references: [id])
  sellerId        String
  seller          User      @relation("VisitSeller", fields: [sellerId], references: [id])
  financeUserId   String?
  financeUser     User?     @relation("VisitFinance", fields: [financeUserId], references: [id], onDelete: SetNull)
  deliveryUserId  String?
  deliveryUser    User?     @relation("VisitDelivery", fields: [deliveryUserId], references: [id], onDelete: SetNull)

  companionCount  Int                 @default(0)
  entryChannel    FairEntryChannel
  awarenessSource FairAwarenessSource
  arrivalMode     FairArrivalMode
  stage           FairVisitStage      @default(WITH_SELLER)
  notes           String?
  lostReason      String?
  bankName        String?

  originCampaignId    String?
  originOpportunityId String?
  originOpportunity   Opportunity? @relation(fields: [originOpportunityId], references: [id], onDelete: SetNull)

  checkedInAt            DateTime  @default(now())
  appraisalRequestedAt   DateTime?
  transferredToFinanceAt DateTime?
  closedAt               DateTime?
  deliveryRequestedAt    DateTime?
  deliveredAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  interests FairVisitInterest[]
  appraisal FairAppraisal?
  delivery  FairDelivery?

  @@index([eventId, stage])
  @@index([sellerId, stage])
  @@index([customerId])
  @@map("fair_visits")
}

model FairVisitInterest {
  id        String     @id @default(cuid())
  visitId   String
  visit     FairVisit  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   FairVehicle @relation(fields: [vehicleId], references: [id])
  primary   Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@unique([visitId, vehicleId])
  @@index([visitId])
  @@map("fair_visit_interests")
}

model FairAppraisal {
  id          String              @id @default(cuid())
  visitId     String              @unique
  visit       FairVisit           @relation(fields: [visitId], references: [id], onDelete: Cascade)
  appraiserId String?
  appraiser   User?               @relation("AppraisalAppraiser", fields: [appraiserId], references: [id], onDelete: SetNull)
  status      FairAppraisalStatus @default(REQUESTED)
  plate       String
  brand       String?
  model       String?
  year        Int?
  fipeValueCents       Int?
  offerValueCents      Int?
  preparationCostCents Int?
  tireFrontLeft        TireCondition?
  tireFrontRight       TireCondition?
  tireRearLeft         TireCondition?
  tireRearRight        TireCondition?
  notes                String?
  requestedAt DateTime            @default(now())
  completedAt DateTime?
  updatedAt   DateTime            @updatedAt

  photos FairAppraisalPhoto[]
  costs  FairAppraisalCost[]

  @@index([status])
  @@map("fair_appraisals")
}

model FairAppraisalPhoto {
  id          String        @id @default(cuid())
  appraisalId String
  appraisal   FairAppraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  slot        FairPhotoSlot @default(DAMAGE)
  url         String
  caption     String?
  costCents   Int?
  createdAt   DateTime      @default(now())

  @@index([appraisalId])
  @@map("fair_appraisal_photos")
}

model FairAppraisalCost {
  id          String                @id @default(cuid())
  appraisalId String
  appraisal   FairAppraisal         @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  kind        FairAppraisalCostKind
  label       String
  costCents   Int                   @default(0)
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())

  @@index([appraisalId])
  @@map("fair_appraisal_costs")
}

model FairDelivery {
  id          String             @id @default(cuid())
  visitId     String             @unique
  visit       FairVisit          @relation(fields: [visitId], references: [id], onDelete: Cascade)
  vehicleId   String?
  vehicle     FairVehicle?       @relation(fields: [vehicleId], references: [id])
  assigneeId  String?
  assignee    User?              @relation("DeliveryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status      FairDeliveryStatus @default(QUEUED)
  pickupOn    DateTime?          @db.Date
  requestedAt DateTime           @default(now())
  startedAt   DateTime?
  deliveredAt DateTime?

  @@index([status])
  @@map("fair_deliveries")
}

model FairTask {
  id          String           @id @default(cuid())
  eventId     String
  event       FairEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String?
  area        String?
  ownerNames  String[]         @default([])
  startsOn    DateTime?        @db.Date
  dueOn       DateTime?        @db.Date
  priority    FairTaskPriority @default(NORMAL)
  status      FairTaskStatus   @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([eventId, status])
  @@index([eventId, dueOn])
  @@map("fair_tasks")
}

model FairExpense {
  id           String    @id @default(cuid())
  eventId      String
  event        FairEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title        String
  notes        String?
  plannedCents Int?
  actualCents  Int?
  spentOn      DateTime? @db.Date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([eventId])
  @@map("fair_expenses")
}
