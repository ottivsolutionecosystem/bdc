# Copie para .env na VPS: cp .env.production.example .env
# Senha só com letras e números (evita quebrar a URL do banco).

POSTGRES_PASSWORD=troqueEstaSenhaDoBanco
AUTH_SECRET=coleAquiOResultadoDe_openssl_rand_-base64_32

# Domínio que aponta para o IP da VPS (sem https://)
DOMAIN=crm.seudominio.com
AUTH_URL=https://crm.seudominio.com
ACME_EMAIL=admin@seudominio.com

AUTH_TRUST_HOST=true
AUTH_DEV_RESET_LINKS=false

# Opcional: webhook padrão do n8n. A campanha também pode ter a URL nas Configurações.
SELLERS_GROUP_WEBHOOK_URL=
